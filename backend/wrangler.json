{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ipsc-ebd-acesso",
  "main": "entry.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://ucp-ipsc.github.io",
    "MATERIAL_REPO": "ucp-ipsc/ebd-infantil-arquivo",
    "MATERIAL_USER": "IPSC_UCP",
    "COORD_USER": "LIDERANCA_IPSC_UCP"
  },
  "ratelimits": [
    {"name":"LOGIN_LIMITER","namespace_id":"701001","simple":{"limit":5,"period":60}},
    {"name":"ACCESS_LIMITER","namespace_id":"701002","simple":{"limit":60,"period":60}}
  ],
  "observability": {"enabled": false}
}
